# Configuration pour git-secrets (https://github.com/awslabs/git-secrets)
# Installez git-secrets avec :
#   git secrets --install
#   git secrets --add '.*'

# Motifs à bloquer (expressions régulières)
# Ajoutez ces motifs avec : git secrets --add '<motif>'

# Clés API et tokens
.*_KEY.*
.*_TOKEN.*
.*_SECRET.*
.*_PASSWORD.*
.*_CREDENTIAL.*

# Clés AWS
AKIA[0-9A-Z]{16}

# Clés Google
AIza[0-9A-Za-z\-_]{35}

# Clés Stripe
sk_live_[0-9a-zA-Z]{24}
pk_live_[0-9a-zA-Z]{24}

# Clés GitHub
ghp_[0-9a-zA-Z]{36}
gho_[0-9a-zA-Z]{36}
ghu_[0-9a-zA-Z]{36}
ghs_[0-9a-zA-Z]{36}

# Clés Slack
xox[baprs]-[0-9a-zA-Z]{10,48}

# Clés Mailchimp
[0-9a-f]{32}-us[0-9]{1,2}

# Clés Twilio
SK[0-9a-fA-F]{32}

# Clés SendGrid
SG.[0-9a-zA-Z\-_]{22}.[0-9a-zA-Z\-_]{43}

# Clés Firebase
AAAA[0-9a-zA-Z\-_]{7}:[0-9a-zA-Z\-_]{140}

# Mots de passe et emails dans les URLs
://[^:]+:[^@]+@

# Clés privées (PEM, etc.)
-----BEGIN (RSA|DSA|EC|OPENSSH|PGP) PRIVATE KEY-----

# Clés Symfony
SYMFONY__[a-zA-Z0-9]{32}

# Clés Laravel
base64:[a-zA-Z0-9+/]{40,}

# Clés JWT
eyJ[a-zA-Z0-9\-_]+\.eyJ[a-zA-Z0-9\-_]+\.[a-zA-Z0-9\-_]+
