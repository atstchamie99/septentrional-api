# Environnement de l'application
APP_NAME="Septentrional API"
APP_ENV=local
APP_KEY=  # Générée avec `php artisan key:generate` (à changer régulièrement)
APP_PREVIOUS_KEYS=  # Anciennes clés séparées par des virgules, utile pendant une rotation contrôlée
APP_DEBUG=false  # Désactivé en production
APP_TIMEZONE=UTC
APP_LOCALE=fr  # Messages de validation en français (voir lang/fr/validation.php)
APP_FALLBACK_LOCALE=fr
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173  # URL du site public, utilisée dans les liens des emails
# IP/CIDR exacts des reverse proxies administrés (Nginx/Cloudflare/cPanel), séparés par des virgules.
# Ne jamais utiliser "*" : l'IP client sert aux throttles et au comptage unique des écoutes.
TRUSTED_PROXIES=127.0.0.1,::1

# Configuration de la base de données
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=SeptentrionalTest
DB_USERNAME=admin
DB_PASSWORD=  # À rotater immédiatement si un secret a été exposé

# Configuration des sessions
SESSION_DRIVER=database
SESSION_LIFETIME=60  # 60 minutes
SESSION_EXPIRE_ON_CLOSE=true
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true  # HTTPS uniquement
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=strict

# Configuration de Sanctum (API Auth)
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1
SANCTUM_ENCRYPTION_KEY=  # Générée avec `php artisan sanctum:generate`
SANCTUM_TOKEN_EXPIRATION=60  # 60 minutes (en minutes)
SANCTUM_OTP_REAUTH_EXPIRATION=43200  # 30 jours, OTP seul sur le même navigateur
SANCTUM_TOKEN_PREFIX=septentrional_  # Préfixe pour éviter les fuites de tokens

# Configuration CORS (à adapter en production)
CORS_ALLOWED_ORIGINS=https://septentrional.tg,https://www.septentrional.tg

# Configuration des logs
LOG_CHANNEL=stack
LOG_LEVEL=info

# Configuration de la file d'attente
QUEUE_CONNECTION=database

# Configuration du cache
CACHE_STORE=file

# Configuration de l'email
MAIL_MAILER=log
MAIL_SCHEME=smtps
MAIL_HOST=mail.septentrional.tg
MAIL_PORT=465
MAIL_USERNAME=no-reply@septentrional.tg
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Clés API tierces (à ne jamais commiter en clair !)
# Exemple : STRIPE_KEY, AWS_ACCESS_KEY_ID, etc.

# Météo du jour (widget sous Flash Info) — clé gratuite sur https://openweathermap.org/api
OPENWEATHER_API_KEY=  # À générer/révoquer depuis le tableau de bord OpenWeather
OPENWEATHER_LAT=9.5511
OPENWEATHER_LON=1.1878

# Source WordPress : lecture seule, distincte de la cible Laravel
WORDPRESS_DB_HOST=127.0.0.1
WORDPRESS_DB_PORT=3306
WORDPRESS_DB_DATABASE=septentrional
WORDPRESS_DB_USERNAME=
WORDPRESS_DB_PASSWORD=
WORDPRESS_TABLE_PREFIX=wp4e_
WORDPRESS_SITE_URL=https://www.septentrional.tg
